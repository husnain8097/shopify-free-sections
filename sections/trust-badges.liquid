<div class="trust-badges" style="background: {{ section.settings.bg }}; padding: 22px 16px;">
  <div style="display:flex; flex-wrap:wrap; gap:18px; justify-content:center; max-width:1000px; margin:0 auto;">
    {% for block in section.blocks %}
      <div style="flex:1 1 180px; max-width:230px; text-align:center;" {{ block.shopify_attributes }}>
        <div style="font-size:28px; line-height:1;">{{ block.settings.icon }}</div>
        <p style="margin:8px 0 2px; font-weight:600;">{{ block.settings.title }}</p>
        <p style="margin:0; color:#555; font-size:13px;">{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#f7f3ee" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🔒" },
        { "type": "text", "id": "title", "label": "Title", "default": "Secure checkout" },
        { "type": "text", "id": "text", "label": "Text", "default": "Your payment is encrypted and protected." }
      ]
    }
  ],
  "presets": [{
    "name": "Trust badges",
    "blocks": [
      { "type": "badge" },
      { "type": "badge" },
      { "type": "badge" },
      { "type": "badge" }
    ]
  }]
}
{% endschema %}
