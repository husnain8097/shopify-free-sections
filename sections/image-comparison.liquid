{% if section.settings.before != blank and section.settings.after != blank %}
<div class="img-compare" style="max-width: {{ section.settings.width }}px; margin: 0 auto; padding: 24px 16px;">
  {% if section.settings.heading != blank %}
    <h2 style="text-align:center; margin: 0 0 16px;">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="img-compare__wrap" style="position:relative; overflow:hidden; border-radius: 10px;">
    <img src="{{ section.settings.after | image_url: width: 1400 }}" alt="{{ section.settings.after.alt | escape }}" style="display:block; width:100%;">
    <div class="img-compare__before" style="position:absolute; inset:0; width:50%; overflow:hidden;">
      <img src="{{ section.settings.before | image_url: width: 1400 }}" alt="{{ section.settings.before.alt | escape }}" style="display:block; height:100%; object-fit:cover;">
    </div>
    <input type="range" min="0" max="100" value="50" aria-label="Compare images"
      style="position:absolute; inset:auto 0 12px 0; width:92%; margin:0 4%;"
      oninput="this.closest('.img-compare__wrap').querySelector('.img-compare__before').style.width = this.value + '%'">
  </div>
  <p style="display:flex; justify-content:space-between; color:#555; font-size:13px; margin:8px 2px 0;">
    <span>{{ section.settings.before_label }}</span><span>{{ section.settings.after_label }}</span>
  </p>
</div>
{% endif %}

{% schema %}
{
  "name": "Image comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before / After" },
    { "type": "image_picker", "id": "before", "label": "Before image" },
    { "type": "image_picker", "id": "after", "label": "After image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "range", "id": "width", "label": "Max width (px)", "min": 480, "max": 1200, "step": 20, "default": 860 }
  ],
  "presets": [{ "name": "Image comparison" }]
}
{% endschema %}
