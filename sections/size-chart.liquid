<div class="size-chart" style="max-width: 720px; margin: 0 auto; padding: 24px 16px;">
  {% if section.settings.heading != blank %}
    <h2 style="text-align:center; margin: 0 0 6px;">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.note != blank %}
    <p style="text-align:center; color:#555; margin: 0 0 16px;">{{ section.settings.note }}</p>
  {% endif %}
  <div style="overflow-x:auto;">
    <table style="width:100%; border-collapse: collapse; text-align:center; font-size: 14px;">
      <thead>
        <tr style="background: {{ section.settings.head_bg }}; color: {{ section.settings.head_fg }};">
          <th style="padding:10px;">EU</th><th style="padding:10px;">US</th><th style="padding:10px;">UK</th><th style="padding:10px;">Foot length (cm)</th>
        </tr>
      </thead>
      <tbody>
        {% assign rows = "36|5.5|3.5|22.9,37|6.5|4.5|23.7,38|7.5|5.5|24.5,39|8.5|6.5|25.0,40|9.5|7.5|25.8,41|10.5|8.5|26.7" | split: "," %}
        {% for row in rows %}
          {% assign c = row | split: "|" %}
          <tr style="border-bottom: 1px solid #e5e5e5;">
            <td style="padding:9px;"><strong>{{ c[0] }}</strong></td><td style="padding:9px;">{{ c[1] }}</td><td style="padding:9px;">{{ c[2] }}</td><td style="padding:9px;">{{ c[3] }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if section.settings.fit_tip != blank %}
    <p style="text-align:center; margin-top:14px;">{{ section.settings.fit_tip }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Size chart (shoes)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "text", "id": "note", "label": "Note under heading", "default": "Measure your foot in the evening and match the length below." },
    { "type": "text", "id": "fit_tip", "label": "Fit tip", "default": "Between sizes? We recommend sizing up." },
    { "type": "color", "id": "head_bg", "label": "Header background", "default": "#111111" },
    { "type": "color", "id": "head_fg", "label": "Header text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Size chart (shoes)" }]
}
{% endschema %}
