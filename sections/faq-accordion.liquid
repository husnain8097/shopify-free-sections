<div class="faq-acc" style="max-width: {{ section.settings.width }}px; margin: 0 auto; padding: 24px 16px;">
  {% if section.settings.heading != blank %}
    <h2 style="text-align:center; margin: 0 0 18px;">{{ section.settings.heading }}</h2>
  {% endif %}
  {% for block in section.blocks %}
    <details class="faq-acc__item" {{ block.shopify_attributes }}>
      <summary class="faq-acc__q">{{ block.settings.question }}</summary>
      <div class="faq-acc__a">{{ block.settings.answer }}</div>
    </details>
  {% endfor %}
</div>

<style>
  .faq-acc__item { border-bottom: 1px solid #e5e5e5; padding: 12px 0; }
  .faq-acc__q { cursor: pointer; font-weight: 600; list-style: none; }
  .faq-acc__q::-webkit-details-marker { display: none; }
  .faq-acc__q::after { content: "+"; float: right; font-weight: 400; }
  details[open ] .faq-acc__q::after { content: "–"; }
  .faq-acc__a { padding-top: 8px; color: #444; }
  .faq-acc__a p { margin: 0 0 8px; }
</style>

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "range", "id": "width", "label": "Max width (px)", "min": 480, "max": 1100, "step": 20, "default": 760 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are delivered within 2–4 working days.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ accordion", "blocks": [{ "type": "faq" }, { "type": "faq" }] }]
}
{% endschema %}
